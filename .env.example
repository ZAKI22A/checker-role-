# ==========================================
# Kiliua Security Intelligence & Checker
# Environment Configuration Template
# ==========================================

# Main Discord Bot Token (Bot Application)
MAIN_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Main Discord Bot Client ID
MAIN_BOT_ID=YOUR_BOT_ID_HERE

# Checker User Token (Discord Selfbot/User Token for multi-server checks)
CHECKER_USER_TOKEN=YOUR_CHECKER_USER_TOKEN_HERE

# Fallback User Token (Secondary user token in case primary is rate-limited)
FALLBACK_USER_TOKEN=YOUR_FALLBACK_USER_TOKEN_HERE

# Checker User ID
CHECKER_USER_ID=YOUR_CHECKER_USER_ID_HERE

# Internal Network Ports
PORT=4567
CHECKER_PORT=4567
DASHBOARD_PORT=4580

# Owner IDs (comma-separated Discord user IDs)
OWNER_IDS=1155753199307870268

# Auto Voice Channel ID (for voice scanner)
AUTO_VOICE_CHANNEL_ID=

# AI API Key (Optional)
AI_API_KEY=

# Security & Role Settings
GRANTABLE_ROLE_ID=
DANGEROUS_ROLE_ID=
CLEAN_ROLE_ID=
LOG_CHANNEL_ID=
EMOJI_UPLOAD_CHANNEL_ID=
STAFF_UPDATE_INTERVAL_MS=600000
